{
  "name": "devungeon",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/dungeon-engine"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "test": "npm run test:engine && npm run test:i18n",
    "test:engine": "tsx --test packages/dungeon-engine/test/*.test.ts",
    "test:i18n": "vitest run packages/workspace-ui/tests/i18n.test.ts --environment node",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.24",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
